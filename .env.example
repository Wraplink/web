# Browser calls Next.js API routes (same-origin) when set to an empty string.
# For direct browser-to-Go access, use http://192.168.108.134:7080 instead.
NEXT_PUBLIC_API_BASE_URL=
# Internal URL accessible by the Next.js server (not exposed to the browser).
BACKEND_INTERNAL_URL=http://127.0.0.1:7080
# Enable only when Next.js ingress sanitizes incoming X-Forwarded-For.
# Do NOT enable on an untrusted public ingress.
BACKEND_PROXY_TRUST_NEXT_FORWARDED_FOR=false

# Cloudflare Turnstile public widget site key (safe to expose in the browser).
# Create a widget for your hostname in https://dash.cloudflare.com/ -> Turnstile.
# Must be available during `next build`; leave empty only if CAPTCHA is disabled server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
